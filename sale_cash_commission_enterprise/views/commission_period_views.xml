<odoo>
    <record id="action_commission_periods" model="ir.actions.act_window">
        <field name="name">Commission Periods</field>
        <field name="res_model">sale.cash.commission.period</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أنشئ أول فترة عمولة لتجميع مستحقات المناديب.
            </p>
        </field>
    </record>

    <record id="view_commission_period_form" model="ir.ui.view">
        <field name="name">sale.cash.commission.period.form</field>
        <field name="model">sale.cash.commission.period</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" type="object" string="إغلاق الفترة"
                            class="btn-primary" invisible="state != 'draft'"/>
<!--                    <button name="action_add_to_payroll" type="object" string="ترحيل لراتب الموظف"-->
<!--                            class="btn-success" invisible="state != 'closed'"/>-->
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="total_amount" widget="monetary" decoration-bf="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="تفاصيل العمولات">
                            <field name="commission_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="invoice_id"/>
                                    <field name="product_id"/>
                                    <field name="paid_amount" sum="Total"/>
                                    <field name="commission_amount" sum="Total"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'open'"
                                           decoration-warning="state == 'closed'"
                                           decoration-success="state == 'invoiced'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_period_tree" model="ir.ui.view">
        <field name="name">sale.cash.commission.period.tree</field>
        <field name="model">sale.cash.commission.period</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_amount" sum="إجمالي العمولات"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'closed'"
                       decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>
</odoo>